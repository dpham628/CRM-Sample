# Zoom API credentials
ZOOM_CLIENT_ID={clientID}
ZOOM_CLIENT_SECRET={clientSecret}

# NextAuth configuration 
NEXTAUTH_URL={https://your-ngrok-url.ngrok-free.app}

# Keep the value of NEXTAUTH_SECRET as is or give it a random string 
NEXTAUTH_SECRET=your_nextauth_secret 

# (Optional) External CRM insights via a Salesforce MCP server.
# When unset, the Insights card uses built-in mock data instead.
# Point at a Salesforce MCP endpoint, e.g. Salesforce's hosted
# SObject Reads server: https://api.salesforce.com/platform/mcp/v1/platform/sobject-reads
# SFDC_MCP_URL=https://api.salesforce.com/platform/mcp/v1/platform/sobject-reads
# (Optional) Bearer token sent to the MCP server (OAuth access token or static token)
# SFDC_MCP_TOKEN=
# (Optional) Name of the query tool to call; defaults to 'soqlQuery'
# SFDC_MCP_QUERY_TOOL=soqlQuery
